# LifeLink AI — Environment Variables Configuration
# Copy this file to .env and provide your actual credentials.
# NEVER commit your actual .env file or API keys to GitHub!

# Server Port
PORT=5000
NODE_ENV=development

# Groq API Configuration (Mandatory AI Requirement: <= 8 Billion Parameters)
# Eligible Model: llama-3.1-8b-instant (8.03B parameters, Meta Llama 3.1 Community License)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Firebase Configuration (Cloud Firestore & Authentication)
# Option A: Individual Firebase Service Account variables
FIREBASE_PROJECT_ID=lifelink-ai-hacktoberfest
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lifelink-ai-hacktoberfest.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to downloaded Service Account JSON file (optional alternative)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Admin Secret / Token for testing admin endpoints
ADMIN_SECRET_KEY=admin_lifelink_secret_2026

# Fallback Offline Demo Mode (Set to true to use in-memory demo data when Firebase credentials are not yet configured)
ENABLE_OFFLINE_DEMO_STORE=true
